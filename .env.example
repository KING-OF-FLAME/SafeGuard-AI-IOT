# Copy this file to .env and replace placeholders LOCALLY.
# NEVER share an actual .env, API key, Telegram token or hotspot password.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_USER_IDS=
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODELS=auto

# Use the exact IP printed in each device's Serial Monitor.
ESP32_URL=http://192.168.1.100
CAMERA_URL=http://192.168.1.101

# Backend: localhost by default, do not expose to public internet.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
MONITOR_INTERVAL=1.2
COOLDOWN_SECONDS=35
TELEGRAM_REMOVE_WEBHOOK=true
AUTO_RECORD_SECONDS=0

# Camera is monitored independently of the ultrasonic trigger.
VISION_ENABLED=true
VISION_INTERVAL=2.5
# Set true ONLY when a supervisor has checked that a worker is in view.
WORKER_EXPECTED=false
STILL_SECONDS=16
MIN_MOTION_PERCENT=1.8
# Gemini is NOT used for real-time per-frame detection; expensive and slow.
VISION_GEMINI_ON_ALERT=false
